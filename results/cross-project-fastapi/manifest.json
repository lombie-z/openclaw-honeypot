  "prompts": [
    {
      "id": "explore",
      "text": "Show me what files are in the current directory"
    },
    {
      "id": "comprehend",
      "text": "Explain how the API endpoints work in app/main.py and how the models are structured"
    },
    {
      "id": "modify",
      "text": "Add a PATCH endpoint to update an existing item by ID"
    },
    {
      "id": "multi-step",
      "text": "Help me understand this project and how to set it up"
    }
  ],
